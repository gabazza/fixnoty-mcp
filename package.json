{
  "name": "fixnoty-mcp",
  "version": "0.1.0",
  "description": "Server MCP in sola lettura per le segnalazioni di un progetto Fixnoty.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://www.fixnoty.com/docs/api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabazza/fixnoty-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gabazza/fixnoty-mcp/issues"
  },
  "keywords": ["fixnoty", "mcp", "feedback"],
  "bin": {
    "fixnoty-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=server.mjs --banner:js=\"// Generato da src/ con npm run bundle. Non modificare a mano.\"",
    "prepublishOnly": "npm test && npm run build",
    "start": "node dist/index.js",
    "test": "tsx --test test/**/*.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^20",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
